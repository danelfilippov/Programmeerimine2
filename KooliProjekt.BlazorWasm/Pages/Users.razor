@page "/lists"
@inject IApiClient apiClient
@inject NavigationManager NavManager

<PageTitle>User</PageTitle>

<h1>Users</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="alert alert-danger">@errorMessage</p>
}

@if (users == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p><a class="btn btn-primary" href="/create">Add new</a></p>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.Title</td>
                    <td>
                        <a class="btn btn-success" href="/edit/@user.Id">Edit</a>
                        <button class="btn btn-danger" @onclick="() => DeleteUser(user.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IList<User> users;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        var result = await apiClient.List(1, 100);
        users = result.Value.Results;
    }

    private async Task DeleteUser(int id)
    {
        errorMessage = "";
        var result = await apiClient.Delete(id);
        if (!result.HasErrors)
        {
            var listResult = await apiClient.List(1, 100);
            users = listResult.Value.Results;
        }
        else
        {
            errorMessage = "Failed to delete user";
        }
    }
}
